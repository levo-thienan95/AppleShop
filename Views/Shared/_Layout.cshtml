<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppleStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AppleStore.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="store-header">
        <nav class="navbar navbar-expand-lg store-nav">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="22" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true">
                        <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
                    </svg>
                    <span>AppleStore</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto">
                        @await Component.InvokeAsync("CategoriesNav")
                    </ul>

                    <form class="d-flex nav-search" role="search" asp-area="" asp-controller="Products" asp-action="Index" method="get">
                        <input class="form-control" type="search" name="q" value="@ViewData["q"]"
                               placeholder="Tìm iPhone, MacBook..." aria-label="Tìm kiếm" />
                        <button class="btn btn-dark" type="submit" aria-label="Tìm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 512 512" fill="currentColor"><path d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z" /></svg>
                        </button>
                    </form>

                    <ul class="navbar-nav ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link cart-link" asp-area="" asp-controller="Cart" asp-action="Index" title="Giỏ hàng">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 448 512" fill="currentColor"><path d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3 .3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5 .3-6.2 2.3zm44.2-1.7c-2.9 .7-4.9 2.6-4.6 4.9 .3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8zM97.2 352.9c-1.3 1-1 3.3 .7 5.2 1.6 1.6 3.9 2.3 5.2 1 1.3-1 1-3.3-.7-5.2-1.6-1.6-3.9-2.3-5.2-1zm-10.8-8.1c-.7 1.3 .3 2.9 2.3 3.9 1.6 1 3.6 .7 4.3-.7 .7-1.3-.3-2.9-2.3-3.9-2-.6-3.6-.3-4.3 .7zm32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2 2.3 2.3 5.2 2.6 6.5 1 1.3-1.3 .7-4.3-1.3-6.2-2.2-2.3-5.2-2.6-6.5-1zm-11.4-14.7c-1.6 1-1.6 3.6 0 5.9 1.6 2.3 4.3 3.3 5.6 2.3 1.6-1.3 1.6-3.9 0-6.2-1.4-2.3-4-3.3-5.6-2z" /></svg>
                                @if (Context.Session.Count() > 0)
                                {
                                    <span class="cart-badge">@Context.Session.Count()</span>
                                }
                                <span class="visually-hidden">Giỏ hàng</span>
                            </a>
                        </li>
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="store-footer mt-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-6 col-md-3">
                    <h6 class="footer-title">Cửa hàng</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-area="" asp-controller="Products" asp-action="Index">Tất cả sản phẩm</a></li>
                        <li><a asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="1">iPhone</a></li>
                        <li><a asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="3">Mac</a></li>
                        <li><a asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoryId="6">Phụ kiện</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="footer-title">Hỗ trợ</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-area="" asp-controller="Orders" asp-action="Index">Theo dõi đơn hàng</a></li>
                        <li><a asp-area="" asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Manage/Index">Tài khoản của tôi</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="footer-title">Tài khoản</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a></li>
                        <li><a asp-area="Identity" asp-page="/Account/Register">Đăng ký</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="footer-title">AppleStore</h6>
                    <p class="footer-note">Đại lý ủy quyền — sản phẩm Apple chính hãng, bảo hành 12 tháng.</p>
                </div>
            </div>
            <hr class="footer-hr" />
            <div class="d-flex flex-wrap justify-content-between footer-note">
                <span>&copy; 2026 AppleStore — Đồ án ASP.NET Core MVC</span>
                <span>Sản phẩm mang dấu hiệu của Apple Inc. chỉ phục vụ mục đích học tập.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
