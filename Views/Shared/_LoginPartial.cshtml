@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            @if (UserManager.GetUserAsync(User).Result?.FullName is string fullName && !string.IsNullOrWhiteSpace(fullName))
            {
                @fullName
            }
            else
            {
                @(User.Identity?.Name)
            }
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Tài khoản của tôi</a></li>
            <li><a class="dropdown-item" asp-area="" asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a></li>
            @if (User.IsInRole("Admin"))
            {
                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị hệ thống</a></li>
            }
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item">Đăng xuất</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-dark btn-sm rounded-pill px-3 py-1 ms-lg-2 mt-2 mt-lg-0" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
    </li>
}
