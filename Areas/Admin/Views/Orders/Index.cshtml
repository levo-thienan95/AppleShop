@model List<Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    string? current = ViewBag.Status;
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    var statusCounts = (Dictionary<OrderStatus, int>)ViewBag.StatusCounts;

    string BadgeClass(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "text-bg-warning",
        OrderStatus.Processing => "text-bg-primary",
        OrderStatus.Shipped => "text-bg-info",
        OrderStatus.Completed => "text-bg-success",
        OrderStatus.Cancelled => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}

<!-- Bộ lọc theo trạng thái -->
<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm rounded-pill @(current == null ? "btn-dark" : "btn-outline-secondary")"
       asp-area="Admin" asp-action="Index">Tất cả (@statusCounts.Values.Sum())</a>
    @foreach (OrderStatus status in Enum.GetValues<OrderStatus>())
    {
        <a class="btn btn-sm rounded-pill @(current == status.ToString() ? "btn-dark" : "btn-outline-secondary")"
           asp-area="Admin" asp-action="Index" asp-route-status="@status">
            @status.GetDisplayName() (@statusCounts.GetValueOrDefault(status, 0))
        </a>
    }
</div>

<div class="admin-panel">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th class="text-center">SL</th>
                    <th class="text-end">Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-semibold">#@order.Id</td>
                        <td>
                            <div>@order.FullName</div>
                            <div class="small text-muted">@order.Phone — @order.Email</div>
                        </td>
                        <td class="small text-muted">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-center">@order.OrderDetails.Sum(d => d.Quantity)</td>
                        <td class="text-end fw-semibold">@order.Total.ToString("n0")₫</td>
                        <td><span class="badge @BadgeClass(order.Status)">@order.Status.GetDisplayName()</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark rounded-pill" asp-area="Admin" asp-action="Details" asp-route-id="@order.Id">Chi tiết</a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Không có đơn hàng nào.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="panel-header justify-content-center">
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @for (var i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == page ? "active" : "")">
                            <a class="page-link" asp-area="Admin" asp-action="Index" asp-route-page="@i" asp-route-status="@current">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
