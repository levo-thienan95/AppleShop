<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị AppleStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <span class="admin-brand-mark"></span> AppleStore <small>Admin</small>
            </a>
            <nav class="admin-nav mt-4">
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">📊 Tổng quan</a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Products" asp-action="Index">📦 Sản phẩm</a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">🗂️ Danh mục</a>
                <a class="admin-nav-link" asp-area="Admin" asp-controller="Orders" asp-action="Index">🧾 Đơn hàng</a>
            </nav>
            <div class="admin-sidebar-footer">
                <a asp-area="" asp-controller="Home" asp-action="Index">← Về trang bán hàng</a>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" class="mt-2">
                    <button type="submit" class="btn btn-sm btn-outline-light rounded-pill w-100">Đăng xuất</button>
                </form>
            </div>
        </aside>

        <!-- Nội dung -->
        <div class="admin-main">
            <header class="admin-topbar d-flex justify-content-between align-items-center">
                <h1 class="h5 mb-0">@ViewData["Title"]</h1>
                <span class="small text-muted">Xin chào, @(User.Identity?.Name)</span>
            </header>

            <div class="admin-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
